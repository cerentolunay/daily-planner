DATABASE_URL=postgresql+psycopg://dailyplanner:dailyplanner@postgres:5432/dailyplanner
POSTGRES_USER=dailyplanner
POSTGRES_PASSWORD=dailyplanner
POSTGRES_DB=dailyplanner
NEXT_PUBLIC_API_URL=http://localhost:8000

AI_PROVIDER=mock
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_DAILY_QUOTA_FREE=20
AI_DAILY_QUOTA_PRO=300
AI_RATE_LIMIT_PER_MINUTE=10
AI_CACHE_ENABLED=true
AI_FALLBACK_ENABLED=true
AI_MAX_MESSAGES_PER_THREAD=10
AI_MAX_CHARS_PER_REQUEST=8000

JWT_SECRET_KEY=change-this-local-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=43200

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@dailyplanner.local
SMTP_FROM_NAME=DailyPlanner
SMTP_USE_TLS=true

AUTH_CODE_EXPIRE_MINUTES=10
AUTH_CODE_RESEND_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_LOCK_MINUTES=15
